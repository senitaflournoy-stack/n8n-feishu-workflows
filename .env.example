# OpenAI-compatible LLM. DeepSeek example:
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=REPLACE_ME
LLM_MODEL=deepseek-chat

# Feishu custom bot webhook (treat as a secret)
FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME

# Feishu custom app for Bitable APIs
FEISHU_APP_ID=cli_REPLACE_ME
FEISHU_APP_SECRET=REPLACE_ME
FEISHU_BITABLE_APP_TOKEN=REPLACE_ME
FEISHU_BITABLE_TABLE_ID=tbl_REPLACE_ME

# OCR adapter endpoint. Expected request: {"url":"..."}
OCR_API_URL=https://your-ocr-adapter.example.com/v1/extract
OCR_API_KEY=REPLACE_ME
